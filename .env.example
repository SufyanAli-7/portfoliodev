# ==============================================================================
# Portfolio Environment Variables Template
# Copy this file to .env or .env.local for local development.
# Configure these variables in the Vercel Project Settings for production.
# ==============================================================================

# MongoDB Connection String (Atlas or Self-Hosted)
# Never expose this variable to the client (do NOT prefix with NEXT_PUBLIC_)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Upstash Redis Distributed Rate Limiting (REST API)
# Get credentials from your Upstash Console: https://console.upstash.com/redis
# Used for sliding-window rate limiting (5 req / 15 min and 20 req / 24 hrs)
UPSTASH_REDIS_REST_URL="https://<your-upstash-database>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-rest-token>"

# Admin Authentication & JWT Security
JWT_SECRET="<generate-a-secure-random-64-character-secret>"
DEFAULT_ADMIN_EMAIL="admin@yourdomain.com"
DEFAULT_ADMIN_PASSWORD="<choose-a-strong-admin-password>"

